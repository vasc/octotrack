{
  "name": "octotrack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "octo": "packages/cli/src/main.ts"
  },
  "scripts": {
    "build": "bun run --cwd packages/web build",
    "dev:web": "bun run --cwd packages/web dev",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "test": "bun test && bun run --cwd packages/web test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
